{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.ng_bike_horse.move": {
			"initial_state": "terre_idle",
			"states": {
				"terre_idle": {
					"animations": [
						"terre_idle"
					],
					"transitions": [
						{
							"terre_idle_mount": "q.is_alive && (v.etat == 1 || v.etat == 5 || v.etat == 9) && !(v.capacite == 1)"
						},
						{
							"terre_forward": "q.is_alive && (v.etat == 2 || v.etat == 3 || v.etat == 6 || v.etat == 7 || v.etat == 10 || v.etat == 11) && !(v.capacite == 1)"
						},
						{
							"sprint": "q.is_alive && v.capacite == 1"
						},
						{
							"death": "!q.is_alive"
						}
					],
					"blend_transition": 0.2
				},
				"terre_idle_mount": {
					"animations": [
						"terre_idle_mount"
					],
					"transitions": [
						{
							"terre_idle": "q.is_alive && (v.etat == 0 || v.etat == 4 || v.etat == 8) && !(v.capacite == 1)"
						},
						{
							"terre_forward": "q.is_alive && (v.etat == 2 || v.etat == 3 || v.etat == 6 || v.etat == 7 || v.etat == 10 || v.etat == 11) && !(v.capacite == 1)"
						},
						{
							"sprint": "q.is_alive && v.capacite == 1"
						},
						{
							"death": "!q.is_alive"
						}
					],
					"blend_transition": 0.2
				},
				"terre_forward": {
					"animations": [
						"terre_forward"
					],
					"transitions": [
						{
							"terre_idle": "q.is_alive && (v.etat == 0 || v.etat == 4 || v.etat == 8) && !(v.capacite == 1)"
						},
						{
							"terre_idle_mount": "q.is_alive && (v.etat == 1 || v.etat == 5 || v.etat == 9) && !(v.capacite == 1)"
						},
						{
							"sprint": "q.is_alive && v.capacite == 1"
						},
						{
							"death": "!q.is_alive"
						}
					],
					"blend_transition": 0.2
				},
				"sprint": {
					"animations": [
						"sprint"
					],
					"transitions": [
						{
							"terre_idle": "q.is_alive && (v.etat == 0 || v.etat == 4 || v.etat == 8) && !(v.capacite == 1)"
						},
						{
							"terre_idle_mount": "q.is_alive && (v.etat == 1 || v.etat == 5 || v.etat == 9) && !(v.capacite == 1)"
						},
						{
							"terre_forward": "q.is_alive && (v.etat == 2 || v.etat == 3 || v.etat == 6 || v.etat == 7 || v.etat == 10 || v.etat == 11) && !(v.capacite == 1)"
						},
						{
							"death": "!q.is_alive"
						}
					],
					"blend_transition": 0.2
				},
				"death": {
					"animations": [
						"death"
					],
					"transitions": [
						{
							"terre_idle": "q.is_alive && (v.etat == 0 || v.etat == 4 || v.etat == 8) && !(v.capacite == 1)"
						},
						{
							"terre_idle_mount": "q.is_alive && (v.etat == 1 || v.etat == 5 || v.etat == 9) && !(v.capacite == 1)"
						},
						{
							"terre_forward": "q.is_alive && (v.etat == 2 || v.etat == 3 || v.etat == 6 || v.etat == 7 || v.etat == 10 || v.etat == 11) && !(v.capacite == 1)"
						},
						{
							"sprint": "q.is_alive && v.capacite == 1"
						}
					],
					"blend_transition": 0.2
				}
			}
		},
		"controller.animation.ng_bike_horse.ambient": {
			"initial_state": "attente",
			"states": {
				"attente": {
					"on_entry": [
						"v.ambiance_fin = q.life_time + math.random(20, 40);"
					],
					"transitions": [
						{
							"son": "q.life_time >= v.ambiance_fin"
						}
					]
				},
				"son": {
					"animations": [
						"ambient"
					],
					"transitions": [
						{
							"attente": "q.all_animations_finished"
						}
					]
				}
			}
		}
	}
}
