						},
						{
							"terre_idle": "q.all_animations_finished"
						}
					]
				}
			}
		},
		"controller.animation.ng_bike_wolf.ambient": {
			"initial_state": "attente",
			"states": {
				"attente": {
					"on_entry": [
						"v.ambiance_fin = q.life_time + math.random(10, 20);"
					],
					"transitions": [
						{
							"son": "q.life_time >= v.ambiance_fin"
						}
					]
				},
				"son": {
					"animations": [
						"ambient"
					],
					"transitions": [
						{
							"attente": "q.all_animations_finished"
						}
					]
				}
			}
		}
	}
}
