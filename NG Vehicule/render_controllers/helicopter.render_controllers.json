{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.helicopter": {
			"geometry": "Geometry.default",
			"materials": [
				{ "*": "Material.default" }
			],
			"textures": [
				"Texture.default"
			],
			"part_visibility": [
				{ "*": true },
				{ "minigun_support": "!q.has_property('ng:turret') || q.property('ng:turret')" },
				{ "minigun": "!q.has_property('ng:turret') || q.property('ng:turret')" },
				{ "grappling": "!q.has_property('ng:winch_kit') || q.property('ng:winch_kit')" },
				{ "missile1": "q.has_property('ng:missile1') && q.property('ng:missile1') > 0" },
				{ "t1_missile1": "q.has_property('ng:missile1') && q.property('ng:missile1') == 1" },
				{ "t2_missile1": "q.has_property('ng:missile1') && q.property('ng:missile1') == 2" },
				{ "t3_missile1": "q.has_property('ng:missile1') && q.property('ng:missile1') == 3" },
				{ "antimatter_missile1": "q.has_property('ng:missile1') && q.property('ng:missile1') == 4" },
				{ "redmatter_missile1": "q.has_property('ng:missile1') && q.property('ng:missile1') == 5" },
				{ "missile2": "q.has_property('ng:missile2') && q.property('ng:missile2') > 0" },
				{ "t1_missile2": "q.has_property('ng:missile2') && q.property('ng:missile2') == 1" },
				{ "t2_missile2": "q.has_property('ng:missile2') && q.property('ng:missile2') == 2" },
				{ "t3_missile2": "q.has_property('ng:missile2') && q.property('ng:missile2') == 3" },
				{ "antimatter_missile2": "q.has_property('ng:missile2') && q.property('ng:missile2') == 4" },
				{ "redmatter_missile2": "q.has_property('ng:missile2') && q.property('ng:missile2') == 5" },
				{ "missile3": "q.has_property('ng:missile3') && q.property('ng:missile3') > 0" },
				{ "t1_missile3": "q.has_property('ng:missile3') && q.property('ng:missile3') == 1" },
				{ "t2_missile3": "q.has_property('ng:missile3') && q.property('ng:missile3') == 2" },
				{ "t3_missile3": "q.has_property('ng:missile3') && q.property('ng:missile3') == 3" },
				{ "antimatter_missile3": "q.has_property('ng:missile3') && q.property('ng:missile3') == 4" },
				{ "redmatter_missile3": "q.has_property('ng:missile3') && q.property('ng:missile3') == 5" },
				{ "missile4": "q.has_property('ng:missile4') && q.property('ng:missile4') > 0" },
				{ "t1_missile4": "q.has_property('ng:missile4') && q.property('ng:missile4') == 1" },
				{ "t2_missile4": "q.has_property('ng:missile4') && q.property('ng:missile4') == 2" },
				{ "t3_missile4": "q.has_property('ng:missile4') && q.property('ng:missile4') == 3" },
				{ "antimatter_missile4": "q.has_property('ng:missile4') && q.property('ng:missile4') == 4" },
				{ "redmatter_missile4": "q.has_property('ng:missile4') && q.property('ng:missile4') == 5" }
			]
		}
	}
}
