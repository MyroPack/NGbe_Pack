{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "nationsglory:penguin_mount",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/penguin_mount"
			},
			"geometry": {
				"default": "geometry.ng_bike_penguin"
			},
			"render_controllers": [
				"controller.render.default"
			],
			"animations": {
				"aqua_forward": "animation.ng_bike_penguin.aqua_forward",
				"aqua_idle": "animation.ng_bike_penguin.aqua_idle",
				"death": "animation.ng_bike_penguin.death",
				"slide": "animation.ng_bike_penguin.slide",
				"terre_forward": "animation.ng_bike_penguin.terre_forward",
				"terre_idle": "animation.ng_bike_penguin.terre_idle",
				"terre_idle_mount": "animation.ng_bike_penguin.terre_idle_mount",
				"ambient": "animation.ng_bike_penguin.ambient",
				"move": "controller.animation.ng_bike_penguin.move",
				"ambient_ctrl": "controller.animation.ng_bike_penguin.ambient"
			},
			"scripts": {
				"pre_animation": [
					"v.env = math.clamp(q.mark_variant, 0, 2);",
					"v.moving = (q.modified_move_speed > 0.05 || (v.env != 0 && math.abs(q.vertical_speed) > 0.05)) ? 1 : 0;",
					"v.mounted = q.has_rider ? 1 : 0;",
					"v.etat = v.env * 4 + v.moving * 2 + v.mounted;",
					"v.capacite = q.variant;"
				],
				"animate": [
					"move",
					"ambient_ctrl"
				]
			},
			"sound_effects": {
				"ambient": "ng_bike.penguin.ambient",
				"death": "ng_bike.penguin.death",
				"ground_forward": "ng_bike.penguin.ground_forward",
				"ground_slide": "ng_bike.penguin.ground_slide",
				"water_forward": "ng_bike.penguin.water_forward"
			}
		}
	}
}
