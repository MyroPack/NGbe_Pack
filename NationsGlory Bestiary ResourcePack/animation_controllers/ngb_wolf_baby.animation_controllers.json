{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ng.wolf_baby.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "move": "v.ngb_moving"
            }
          ],
          "blend_transition": 0.25
        },
        "move": {
          "animations": [
            {
              "move": "math.clamp(query.modified_move_speed, 0.3, 1.0)"
            }
          ],
          "transitions": [
            {
              "idle": "!v.ngb_moving"
            }
          ],
          "blend_transition": 0.25
        }
      }
    }
  }
}
