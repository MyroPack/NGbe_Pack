{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ng:wolf",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/ngb/wolf_0",
        "v1": "textures/entity/ngb/wolf_1",
        "v2": "textures/entity/ngb/wolf_2",
        "v3": "textures/entity/ngb/wolf_3"
      },
      "geometry": {
        "default": "geometry.ng.wolf"
      },
      "animations": {
        "idle": "animation.ng.wolf.idle",
        "move": "animation.ng.wolf.move",
        "controller": "controller.animation.ng.wolf.move",
        "look": "animation.ng.wolf.look"
      },
      "scripts": {
        "initialize": [
          "variable.ngb_moving = 0.0;",
          "variable.ngb_look_x = 0.0;",
          "variable.ngb_look_y = 0.0;"
        ],
        "pre_animation": [
          "variable.ngb_moving = variable.ngb_moving ? query.modified_move_speed > 0.02 : query.modified_move_speed > 0.05;",
          "variable.ngb_look_x = variable.ngb_look_x + (math.clamp(query.target_x_rotation, -30, 30) - variable.ngb_look_x) * math.min(1, query.delta_time * 6);",
          "variable.ngb_look_y = variable.ngb_look_y + (math.clamp(query.target_y_rotation, -55, 55) - variable.ngb_look_y) * math.min(1, query.delta_time * 6);"
        ],
        "animate": [
          "controller",
          "look"
        ]
      },
      "render_controllers": [
        "controller.render.ng.wolf"
      ],
      "spawn_egg": {
        "base_color": "#26242a",
        "overlay_color": "#39363c"
      }
    }
  }
}
