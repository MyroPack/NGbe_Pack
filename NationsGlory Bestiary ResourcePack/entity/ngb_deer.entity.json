{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ng:deer",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/ngb/deer_0",
        "v1": "textures/entity/ngb/deer_1"
      },
      "geometry": {
        "default": "geometry.ng.deer"
      },
      "animations": {
        "idle": "animation.ng.deer.idle",
