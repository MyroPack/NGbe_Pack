{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ng:owl",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/ngb/owl_0",
        "v1": "textures/entity/ngb/owl_1",
        "v2": "textures/entity/ngb/owl_2",
        "v3": "textures/entity/ngb/owl_3"
      },
      "geometry": {
        "default": "geometry.ng.owl"
      },
      "animations": {
        "idle": "animation.ng.owl.idle",
        "move": "animation.ng.owl.move",
        "fly_idle": "animation.ng.owl.fly_idle",
        "fly_move": "animation.ng.owl.fly_move",
        "controller": "controller.animation.ng.owl.move",
        "look": "animation.ng.owl.look"
      },
      "scripts": {
        "initialize": [
          "variable.ngb_moving = 0.0;",
          "variable.ngb_look_x = 0.0;",
          "variable.ngb_look_y = 0.0;"
        ],
        "pre_animation": [
          "variable.ngb_flying = query.mark_variant == 1;",
          "variable.ngb_moving = (variable.ngb_moving ? query.modified_move_speed > 0.02 : query.modified_move_speed > 0.05) || (variable.ngb_flying && math.abs(query.vertical_speed) > 0.05);",
          "variable.ngb_look_x = variable.ngb_look_x + (math.clamp(query.target_x_rotation, -30, 30) - variable.ngb_look_x) * math.min(1, query.delta_time * 6);",
          "variable.ngb_look_y = variable.ngb_look_y + (math.clamp(query.target_y_rotation, -55, 55) - variable.ngb_look_y) * math.min(1, query.delta_time * 6);"
        ],
        "animate": [
          "controller",
          "look"
        ]
      },
      "render_controllers": [
        "controller.render.ng.owl"
      ],
      "spawn_egg": {
        "base_color": "#574333",
        "overlay_color": "#443127"
      }
    }
  }
}
