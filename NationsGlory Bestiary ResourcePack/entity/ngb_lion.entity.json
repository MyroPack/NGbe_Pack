      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/ngb/lion_0",
        "v1": "textures/entity/ngb/lion_1"
      },
      "geometry": {
        "default": "geometry.ng.lion"
      },
      "animations": {
        "idle": "animation.ng.lion.idle",
        "move": "animation.ng.lion.move",
