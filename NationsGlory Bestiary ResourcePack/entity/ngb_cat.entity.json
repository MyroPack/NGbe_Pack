        "v2": "textures/entity/ngb/cat_2",
        "v3": "textures/entity/ngb/cat_3",
        "v4": "textures/entity/ngb/cat_4",
        "v5": "textures/entity/ngb/cat_5"
      },
      "geometry": {
        "default": "geometry.ng.cat"
