{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ng:eagle",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/ngb/eagle_0"
      },
      "geometry": {
        "default": "geometry.ng.eagle"
      },
      "animations": {
        "idle": "animation.ng.eagle.idle",
        "move": "animation.ng.eagle.move",
        "fly_idle": "animation.ng.eagle.fly_idle",
        "fly_move": "animation.ng.eagle.fly_move",
        "controller": "controller.animation.ng.eagle.move",
        "look": "animation.ng.eagle.look"
      },
      "scripts": {
        "pre_animation": [
          "variable.ngb_moving = query.modified_move_speed > 0.05 || math.abs(query.vertical_speed) > 0.05;",
          "variable.ngb_flying = query.mark_variant == 1;"
        ],
        "animate": [
          "controller",
          "look"
        ]
      },
      "render_controllers": [
        "controller.render.ng.eagle"
      ],
      "spawn_egg": {
        "base_color": "#261810",
        "overlay_color": "#e3ded0"
      }
    }
  }
}
