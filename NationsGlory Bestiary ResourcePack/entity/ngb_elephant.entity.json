{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ng:elephant",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/ngb/elephant_0"
      },
      "geometry": {
        "default": "geometry.ng.elephant"
      },
      "animations": {
        "idle": "animation.ng.elephant.idle",
        "move": "animation.ng.elephant.move",
        "attack": "animation.ng.elephant.attack",
        "controller": "controller.animation.ng.elephant.move",
        "look": "animation.ng.elephant.look"
      },
      "scripts": {
        "initialize": [
          "variable.ngb_moving = 0.0;",
          "variable.ngb_look_x = 0.0;",
          "variable.ngb_look_y = 0.0;"
        ],
        "pre_animation": [
          "variable.ngb_moving = variable.ngb_moving ? query.modified_move_speed > 0.02 : query.modified_move_speed > 0.05;",
          "variable.ngb_look_x = variable.ngb_look_x + (math.clamp(query.target_x_rotation, -30, 30) - variable.ngb_look_x) * math.min(1, query.delta_time * 6);",
          "variable.ngb_look_y = variable.ngb_look_y + (math.clamp(query.target_y_rotation, -55, 55) - variable.ngb_look_y) * math.min(1, query.delta_time * 6);"
        ],
        "animate": [
          "controller",
          "look"
        ]
      },
      "render_controllers": [
        "controller.render.ng.elephant"
      ],
      "spawn_egg": {
        "base_color": "#6f6f6f",
        "overlay_color": "#d8d3c7"
      }
    }
  }
}
