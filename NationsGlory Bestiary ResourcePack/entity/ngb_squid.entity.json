{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ng:squid",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/ngb/squid_0",
        "v1": "textures/entity/ngb/squid_1"
      },
      "geometry": {
        "default": "geometry.ng.squid"
      },
      "animations": {
        "idle": "animation.ng.squid.idle",
        "move": "animation.ng.squid.move",
        "controller": "controller.animation.ng.squid.move"
      },
      "scripts": {
        "pre_animation": [
          "variable.ngb_moving = query.modified_move_speed > 0.05 || math.abs(query.vertical_speed) > 0.05;"
        ],
        "animate": [
          "controller"
        ]
      },
      "render_controllers": [
        "controller.render.ng.squid"
      ],
      "spawn_egg": {
        "base_color": "#d0cfca",
        "overlay_color": "#a19191"
      }
    }
  }
}
