{
	"format_version": "1.10.0",
	"render_controllers": {
		"controller.render.rank_animate_tag": {
			"geometry": "Geometry.nametag",
			"materials": [
				{
					"*": "Material.nametag"
				}
			],
			"textures": [
				"Array.rank_tag[math.clamp(q.mark_variant - 3, 0, 1)]"
			],
			"arrays": {
