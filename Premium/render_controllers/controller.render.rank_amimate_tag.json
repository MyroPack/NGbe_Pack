						"Texture.pioneer_tag_animated",
						"Texture.gold_tag_animated"
					]
				}
			},
			"uv_anim": {
				"offset": [
					0,
					"math.mod(math.floor(query.life_time*5), 8)/8"
				],
				"scale": [
					1,
					0.125
				]
			}
		}
	}
}
