{
  "format_version": "1.8.0",
  "animations": {
    "animation.ngpremium.player.holding": {
      "loop": true,
      "bones": {
        "leftarm": {
          "rotation": [
            "(variable.is_holding_left && !query.is_item_name_any('slot.weapon.offhand', 0, 'ngpremium:app_button')) ? (-this * 0.5 - 18.0) : 0.0",
            0.0,
            0.0
          ]
        },
        "rightarm": {
          "rotation": [
            "variable.is_holding_right ? (-this * 0.5 - 18.0) : 0.0",
            0.0,
            0.0
          ]
        }
      }
    }
  }
}
