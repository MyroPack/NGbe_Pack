{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "ng:shovel_electric",
			"item": {
				"ng:shovel_electric": "query.is_owner_identifier_any('minecraft:player')"
			},
			"render_controllers": [
				"controller.render.item_default"
			],
			"materials": {
				"default": "entity_alphablend",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/entity/electric_tools/shovel_electric",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.ng_shovel_electric"
			},
			"animations": {
				"first_person_hold": "animation.ng_electric_tool.first_person_hold",
				"third_person_hold": "animation.ng_electric_tool.third_person_hold"
			},
			"scripts": {
				"animate": [
					{
						"first_person_hold": "c.is_first_person"
					},
					{
						"third_person_hold": "!c.is_first_person"
					}
				]
			}
		}
	}
}
