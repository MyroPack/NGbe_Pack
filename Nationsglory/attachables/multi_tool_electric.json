{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "ng:multi_tool_electric",
			"item": { "ng:multi_tool_electric": "query.is_owner_identifier_any('minecraft:player')" },
			"render_controllers": ["controller.render.item_default"],
			"materials": {
				"default": "entity_alphablend",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/items/multi_tool_electric",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.multi_tool_electric"
			},
			"animations": {
				"first_person_hold": "animation.multi_tool_electric.first_person_hold",
				"third_person_hold": "animation.multi_tool_electric.third_person_hold",
				"first_person_hold_active": "animation.multi_tool_electric.first_person_hold_active",
				"third_person_hold_active": "animation.multi_tool_electric.third_person_hold_active"
			},
			"scripts": {
				"animate": [
					{
						"first_person_hold": "!query.is_sneaking && c.is_first_person"
					},
					{
						"third_person_hold": "!query.is_sneaking && !c.is_first_person"
					},
					{
						"first_person_hold_active": "query.is_sneaking && c.is_first_person"
					},
					{
						"third_person_hold_active": "query.is_sneaking && !c.is_first_person"
					}
				]
			}
		}
	}
}
