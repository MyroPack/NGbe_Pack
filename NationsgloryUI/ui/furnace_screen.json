  "flame_empty_image@ng_asset.icon_18": {
    "layer": 2
  },

  "flame_full_image@ng_asset.icon_18": {
    "layer": 3,
    "clip_direction": "down",
    "color":[1.000, 0.827, 0.392],
    "bindings": [
      {
        "binding_name": "#furnace_flame_ratio",
        "binding_name_override": "#clip_ratio",
        "binding_condition": "always"
      }
  ]},

  "furnace_panel": {
    "type": "panel",
    "controls": [

            {"background@ng_asset.background_02":{
              "size":[287,117], 
              "controls":[

                  {"stackpanel@ng_module.stackpanel":{ 
                    "size":["100% - 2px","100% - 2px"], 
                    "controls":[

                  {"header@ng_asset.background_01":{
                      "size": ["100%",20],
                      "controls":[

                                {"stack_panel@ng_module.stackpanel":{
                                  "orientation":"horizontal",
                                  "size":["100% - 4px","100% - 2px"],
                                  "controls":[

                                                            {"padding@ng_module.panel":{
                                                                "size":[5,"100%"]
                                                            }},

                                                            {"centring@ng_module.panel":{
                                                                "size":["100%c","100%"],
                                                                "controls":[
                                                                
                                                                              {"title":{
                                                                                "type":"label",
                                                                                "font_scale_factor":0.8,
                                                                                "layer":5,
                                                                                "offset":[0,-1.3],
                                                                                "font_type":"MinecraftTen",
                                                                                "text":"Fourneau"
                                                                              }}
                                                            ]}},

                                                            {"padding@ng_module.panel":{
                                                              "size":["fill","100%"]
                                                            }},

                                                            {"centring@ng_module.panel":{
                                                              "size":["100%c","100%"],
                                                              "controls":[

                                                                    {"close_button@ng_module.close_button":{}}  

                                                            ]}}
                                ]}}
                  ]}},

                  {"content@ng_module.panel":{
                    "size":["100%",100],
                    "controls":[

                        {"stackpnel@ng_module.stackpanel":{
                          "orientation":"horizontal",
                          "size":["100% - 10px","100% - 10px"],
                          "controls":[

