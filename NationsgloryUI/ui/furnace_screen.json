                                        "size":[190,85],
                                        "controls":[

                                                          {"inventory_&_hotbar@ng_module.stackpanel":{
                                                            "size":[189,84],
                                                            "offset":[0.5,0.5],
                                                            "controls":[

                                                                {"complementaroy@ng_module.grid_asset":{
                                                                  "$size_grid":[189,63],
                                                                  "$grid_dimensions":[9,3],
                                                                  "layer":0,
                                                                  "$collection_name":"inventory_items",
                                                                  "$item_renderer_panel_size":[20,20],
                                                                  "$cell_image_size":[20,20],
                                                                  "$textures_slot_hover":"ng_asset.background_10",
                                                                  "$textures_slot_default":"ng_asset.background_white",
                                                                  "$color_background_default":[0.094, 0.094, 0.106],
                                                                  "$slot_size":[20,20]
                                                                }},

                                                                {"complementaroy@ng_module.grid_asset":{
                                                                  "$size_grid":[189,21],
                                                                  "$grid_dimensions":[9,1],
                                                                  "layer":0,
                                                                  "$collection_name":"hotbar_items",
                                                                  "$item_renderer_panel_size":[20,20],
                                                                  "$cell_image_size":[20,20],
                                                                  "$textures_slot_hover":"ng_asset.background_10",
                                                                  "$textures_slot_default":"ng_asset.background_white",
                                                                  "$color_background_default":[0.094, 0.094, 0.106],
                                                                  "$slot_size":[20,20]
                                                                }}
                                                          ]}}
                                      ]}},

                                      {"padding@ng_module.panel": {
                                        "size": [5, "100%"]
                                      }},

                                      {"content@ng_module.stackpanel":{
                                        "size": ["100% - 195px","100% - 5px"],
                                        "controls":[

                                            {"header@ng_asset.background_12":{
                                              "size": ["100%",15],
                                              "controls":[

                                                        {"stack_panel@ng_module.stackpanel":{
                                                          "orientation":"horizontal",
                                                          "size":["100% - 4px","100% - 2px"],
                                                          "controls":[

                                                                      {"padding@ng_module.panel":{
                                                                        "size":[5,"100%"]
                                                                      }},

                                                                      {"centring@ng_module.panel":{
                                                                        "size":["100%c","100%"],
                                                                        "controls":[
                                                                                        
                                                                                  {"title":{
                                                                                    "type":"label",
                                                                                    "font_scale_factor":0.7,
                                                                                    "layer":5,
                                                                                    "offset":[0,-1],
                                                                                    "font_type":"MinecraftTen",
                                                                                    "text":"Fourneau"
                                                                                    }}
                                                                      ]}}                 
                                                        ]}}
                                            ]}},

                                            {"content@ng_asset.background_11":{
                                              "size":["100%","100% - 15px"],
                                              "controls":[

                                                {"stack_panel@ng_module.stackpanel":{
                                                  "orientation":"horizontal",
                                                  "size":["100% - 10px","100% - 10px"], 
                                                  "controls":[

                                                          {"stackpane@ng_module.stackpanel":{
                                                            "size":["100%cm","100%"],
                                                            "controls":[

                                                                {"slot@furnace.custome_slot":{
                                                                  "$item_collection_name":"furnace_ingredient_items"
                                                                }},

                                                                {"padding@ng_module.panel": {
                                                                  "size": [21, "fill"],
                                                                  "controls":[

                                                                      {"flame_panel": {
                                                                        "type": "panel",
                                                                        "size": [ 15, 15 ],
                                                                        "controls": [

                                                                            {"flame_empty_image@furnace.flame_empty_image": {}},
                                                                            {"flame_full_image@furnace.flame_full_image": {}}
                                                                      ]}}

                                                                ]}},

                                                                {"slot@furnace.custome_slot":{
                                                                  "$item_collection_name":"furnace_fuel_items"
                                                                }}
                                                          ]}},

                                                          {"padding@ng_module.panel": {
                                                            "size": ["fill", "100%"],
                                                            "controls":[

                                                                      {"icone@ng_asset.icon_17":{
                                                                        "size":[15,15]
                                                                      }}
                                                          ]}},

                                                          {"stackpane@ng_module.stackpanel":{
                                                            "size":["100%cm","100%"],
                                                            "controls":[

                                                                {"center@ng_module.panel": {
                                                                  "size": ["100%c", "100%"],
                                                                  "controls":[

                                                                    {"slot_sortie@furnace.custome_slot":{
                                                                      "$item_collection_name":"furnace_output_items"
                                                                    }}


                                                                ]}}

                                                          ]}}
                                                ]}}

                                            ]}}

                                      ]}}
                        ]}}
                  ]}}
