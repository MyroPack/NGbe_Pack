  "notification_inside": {
    "type": "stack_panel",
    "size": ["100%","100%"],
    "orientation": "horizontal",
    "$icon_color|default": "white",
    "controls": [

      {"icon@ng_asset.background_white": {
        "color":"$icon_outilne_background_color",
        "size": [30,"100%"],
        "controls": [

            {"icon@ng_asset.background_white": {
              "color":"$icon_background_color",
              "anchor_from": "right_middle",
              "anchor_to": "right_middle",
              "size": ["100% - 1px","100% - 2px"],
              "controls": [

                {"icon_texture@$icon_texture":{
                  "color":"$icon_color",
                  "size":[18,18]
                }}
            ]}}
      ]}},

      {"content@ng_asset.background_white": {
        "color":"$outline_background_color",
        "size": ["fill","100%"],
        "controls": [

            {"content@ng_asset.background_white": {
              "color": "$content_background_color",
              "layer":1,
              "size": ["100% - 2px","100% - 2px"],
              "controls": [

                  {"stackpanel@ng_module.stackpanel":{
                    "offset":[0,-1],
                    "size":["100% - 10px","100%c"],
                    "controls":[

                        {"title_label": {
                          "type": "label",
                          "text": "#text2",
                          "max_size":["100%",10],
                          "font_type": "MinecraftTen",
                          "font_scale_factor": 0.86,
                          "layer": 1000000000,
                          "color": "white",
                          "property_bag": {
                            "#search": 0,
                            "#search_2": 0,
                            "#tail": "",
                            "#separator": ";"
                          },
                          "bindings": [
                              {
                                "binding_collection_name": "chat_text_grid",
                                "binding_condition": "once",
                                "binding_name_override": "#text",
                                "binding_name": "#chat_text",
                                "binding_type": "collection"
                              },
                              {
                                "binding_condition": "always",
                                "binding_type": "view",
                                "source_property_name": "(#search + 1 * ( not (('%.'+#search+'s') * #text = #text) and (('%.'+#search+'s') * #text = ('%.'+#search+'s') * #text - #separator) ))",
                                "target_property_name": "#search"
                              },
                              {
                                "binding_type": "view",
                                "source_property_name": "(#text - (('%.'+#search+'s') * #text))",
                                "target_property_name": "#tail"
                              },
                              {
                                "binding_condition": "always",
                                "binding_type": "view",
                                "source_property_name": "(#search_2 + 1 * ( not (('%.'+#search_2+'s') * #tail = #tail) and (('%.'+#search_2+'s') * #tail = ('%.'+#search_2+'s') * #tail - #separator) ))",
                                "target_property_name": "#search_2"
                              },
                              {
                                "binding_type": "view",
                                "source_property_name": "((('%.'+#search_2+'s') * #tail) - #separator)",
                                "target_property_name": "#text2"
                              },
                              {
                                "binding_type": "view",
                                "source_property_name": "(#text - '§o')",
                                "target_property_name": "#display_text"
                              }
                            ]
                        }},

                        {"padding@ng_module.panel": {
                          "size": ["100%", 1]
                        }},

                        {"content": {
                            "type": "label",
                            "text": "#text",
                            "font_scale_factor": 0.6,
                            "layer": 1000000,
                            "max_size":["100%",14],
                            "property_bag": {
                              "#search": 0,
                              "#separator": ";"
                            },
                            "bindings": [
                              {
                                "binding_collection_name": "chat_text_grid",
                                "binding_condition": "once",
                                "binding_name_override": "#text",
                                "binding_name": "#chat_text",
                                "binding_type": "collection"
                              },
                              {
                                "binding_condition": "always",
                                "binding_type": "view",
                                "source_property_name": "(#search + 1 * ( not (('%.'+#search+'s') * #text = #text) and (('%.'+#search+'s') * #text = ('%.'+#search+'s') * #text - #separator) ))",
                                "target_property_name": "#search"
                              },
                              {
                                "binding_type": "view",
                                "source_property_name": "((('%.'+#search+'s') * #text) - #separator)",
                                "target_property_name": "#text"
                              },
                              {
                                "binding_type": "view",
                                "source_property_name": "(#text - '§o')",
                                "target_property_name": "#display_text"
                              }
                            ]
                        }}
                  ]}}
            ]}}
      ]}}
  ]},

