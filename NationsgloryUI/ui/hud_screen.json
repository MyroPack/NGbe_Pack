  // -----------------------------------------------
  //
  //             Notification
  //
  // -----------------------------------------------

  "notification": {
    "type": "panel",
    "size": [144,"100%c"],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "controls": [

      {"notification_panel@hud.notification_panel": {
        "bindings": [
            {
              "binding_name": "#chat_text",
              "binding_name_override": "#text",
              "binding_type": "collection",
              "binding_collection_name": "chat_text_grid",
              "binding_condition": "once"
            },
            {
              "binding_type": "view",
              "source_property_name": "((('%.6s' * #text) = '§b§r') or (('%.6s' * #text) = '§i§r') or (('%.6s' * #text) = '§a§r') or (('%.6s' * #text) = '§e§r') or (('%.6s' * #text) = '§s§r') or (('%.6s' * #text) = '§t§r'))",
              "target_property_name": "#visible",
              "binding_condition": "once"
            },
            {
              "binding_type": "view",
              "source_property_name": "((('%.6s' * #text) = '§b§r') or (('%.6s' * #text) = '§i§r') or (('%.6s' * #text) = '§a§r') or (('%.6s' * #text) = '§e§r') or (('%.6s' * #text) = '§s§r') or (('%.6s' * #text) = '§t§r'))",
              "target_property_name": "#enabled",
              "binding_condition": "once"
            }
      ]}}
  ]},

  "notification_panel": {
    "type": "panel",
    "size": ["100%", "100%c + 4px"],
    "anims": ["@hud.notification_in"],
    "controls": [

      {"notification_background": {
        "type": "image",
        "size": ["100%", "100%c"],
        "controls": [

          {"panel": {
            "type": "panel",
            "size": ["100%", 30],
            "controls": [

