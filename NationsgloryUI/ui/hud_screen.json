{
  "namespace": "hud",

  // Viseur de l'appareil photo du bestiaire (NGBestiaryResourcePack, ui/ngbestiary_hud.json), en plein ecran.
  // Il est le fond de l'ecran du HUD : le seul controle que le jeu place hors de la zone de securite de l'ecran
  // (comme le fond sombre des ecrans de coffre et d'inventaire). Il va donc d'un bord a l'autre de l'ecran, quel
  // que soit le reglage « zone de securite » du joueur. Vide sans le pack du bestiaire.
  "hud_screen@common.base_screen": {
    "$screen_bg_content": "ngbestiary_hud.viewfinder"
  },


  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "notif": {
              "ignored": "$pocket_screen",
              "type": "panel",
              "size": [
                "100%",
                "100%"
              ],
              "controls": [
                {
                  "notif": {
                    "type": "stack_panel",
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "size": [
                      144,
                      "100%"
                    ],
                    "controls": [
                      {
                        "padding": {
                          "type": "panel",
                          "size": [
                            "100%",
                            "fill"
                          ],
                          "controls": [
                          ]
                        }
                      },
                      {
                        "top_right_notification": {
                          "type": "stack_panel",
                          "layer":900000000000000000000000000000000,
                          "size": [
                            144,
                            "100%c"
                          ],
                          "factory": {
                            "name": "chat_item_factory",
                            "control_ids": {
                              "chat_item": "top_right@hud.notification"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          // Version mobile (profil d'interface Pocket) : les memes bandeaux, en haut a droite au lieu du bas a droite,
          // qui est sous le bouton de saut des commandes tactiles. Un bandeau se pose pendant ses 5 secondes sur les
          // cases de l'argent, des points, du pseudo et de la date (y = 24 a 54) ; l'armure, dessous, reste visible.
          // Plus bas, sur un telephone, il arriverait a hauteur du viseur.
          {
            "notif_pocket": {
              "ignored": "(not $pocket_screen)",
              "type": "panel",
              "size": [
                "100%",
                "100%"
              ],
              "controls": [
                {
                  "notif": {
                    "type": "stack_panel",
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "size": [
                      144,
                      "100%"
                    ],
                    "controls": [
                      {
                        "padding": {
                          "type": "panel",
                          "size": [
                            "100%",
                            25
                          ]
                        }
                      },
                      {
                        "top_right_notification": {
                          "type": "stack_panel",
                          "layer":900000000000000000000000000000000,
                          "size": [
                            144,
                            "100%c"
                          ],
                          "factory": {
                            "name": "chat_item_factory",
                            "control_ids": {
                              "chat_item": "top_right@hud.notification"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    ],
    "controls": [
      {
        "layout_customization_reset": {
          "type": "image",
          "size": [
            "200%",
            "200%"
          ],
          "texture": "textures/ui/Black.png",
          "fill": true,
          "alpha": 0.5,
          "layer": 50,
          "controls": [
            {
              "layout_customization_reset_modal@common_dialogs.main_panel_two_buttons": {
                "size": [
                  210,
                  160
                ],
                "$show_close_button": false,
                "$child_control": "library_modal.modal_text_content",
                "$top_button_panel": "hud.wysiwyg_reset_modal_ok",
                "$bottom_button_panel": "hud.wysiwyg_reset_modal_cancel",
                "$modal_text": "hudScreen.controlCustomization.resetModalText"
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#reset_modal_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "layout_customization_close_without_saving": {
          "type": "image",
          "size": [
            "200%",
            "200%"
          ],
          "texture": "textures/ui/Black.png",
          "fill": true,
          "alpha": 0.5,
          "layer": 50,
          "controls": [
            {
              "layout_customization_close_without_saving_modal@common_dialogs.main_panel_two_buttons": {
                "size": [
                  210,
                  160
                ],
                "$show_close_button": false,
                "$child_control": "library_modal.modal_text_content",
                "$top_button_panel": "hud.wysiwyg_close_without_saving_modal_ok",
                "$bottom_button_panel": "hud.wysiwyg_close_without_saving_modal_cancel",
                "$modal_text": "hudScreen.controlCustomization.closeWithoutSavingModalText"
