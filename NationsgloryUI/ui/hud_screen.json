  // Version mobile (profil d'interface Pocket) : la poupee du joueur que le jeu dessine en haut a gauche (15, 25)
  // tomberait sur la case de position et sur le canal de tchat. Elle est retiree en profil Pocket, comme le pack la
  // retire deja du bureau (centered_gui_elements, plus haut). En profil Classic ce controle reste celui du jeu.
  "not_centered_gui_elements": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "replace",
        "control_name": "hud_player_rend_pocket",
        "value": [
          {
            "hud_player_rend_pocket@hud_player_renderer": {
              "ignored": "$pocket_screen",
              "offset": [ 15, 25 ],
              "anchor_from": "top_left",
              "anchor_to": "top_left"
            }
          }
        ]
      }
    ]
  },

  "chat_grid_item": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "replace",
        "control_name": "chat_background",
        "value": [
          {
            "chat_background": {
              "type": "image",
              "texture": "textures/ui/Black",
              "alpha": 0.5,
              "size": ["100%","100%cm + 4px"],
              "anims": ["@hud.anim_chat_bg_wait"],
              "controls": [
                {
                  "chat_text@chat_label": {
                    "offset": [3,0],
                    "$chat_font_scale_factor": 0.8
                  }
                }
              ],
              "bindings": [
                {
                  "binding_name": "#chat_text",
                  "binding_name_override": "#text",
                  "binding_type": "collection",
                  "binding_collection_name": "chat_text_grid",
                  "binding_condition": "once"
                },
                {
                  "binding_type": "view",
                  "source_property_name": "(not ((('%.6s' * #text) = '§b§r') or (('%.6s' * #text) = '§i§r') or (('%.6s' * #text) = '§a§r') or (('%.6s' * #text) = '§e§r') or (('%.6s' * #text) = '§s§r') or (('%.6s' * #text) = '§t§r')))",
                  "target_property_name": "#visible",
                  "binding_condition": "once"
                },
                {
                  "binding_type": "view",
                  "source_property_name": "(not ((('%.6s' * #text) = '§b§r') or (('%.6s' * #text) = '§i§r') or (('%.6s' * #text) = '§a§r') or (('%.6s' * #text) = '§e§r') or (('%.6s' * #text) = '§s§r') or (('%.6s' * #text) = '§t§r')))",
                  "target_property_name": "#enabled",
                  "binding_condition": "once"
                }
              ]
            }
          }
        ]
      }
    ]
  },

  // -----------------------------------------------
