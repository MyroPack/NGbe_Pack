  // Une case du sac. L'index est sur la case elle-meme, enfant direct de la rangee qui nomme la collection (comme
  // dans tous les composants NG) ; plus bas, l'objet n'est pas dessine.
  "backpack_slot": {
    "type": "panel",
    "size": [21, 21],
    "$index|default": 0,
    "collection_index": "$index",
    "controls": [

      {"slot@ng_module.container_item": {
        "$item_collection_name": "container_items",
        "$mapping_container": "container_mapping_quick_move",
        "$slot_size": [20, 20],
        "$cell_image_size": [20, 20],
        "$item_renderer_panel_size": [20, 20],
        "$textures_slot_hover": "ng_asset.background_10",
        "$textures_slot_default": "ng_asset.background_white",
        "$color_background_default": [0.094, 0.094, 0.106]
      }}
  ]},

  // Les cadenas, par-dessus la grille : une ligne de cadenas pour chaque ligne que la case 62 nomme (« L4 »). Un
  // objet laisse dans une ligne retiree par le staff reste visible au travers et peut etre sorti.
  "locks@ng_module.stackpanel": {
    "size": [189, 126],
    "layer": 50,
    "controls": [

      // La premiere ligne est toujours achetee.
      {"row_1@ng_module.panel": {
        "size": ["100%", 21]
      }},

      {"row_2@ng_module.collectionpanel": {
        "collection_name": "container_items",
        "size": ["100%", 21],
        "controls": [

          {"lock": {
            "type": "stack_panel",
            "orientation": "horizontal",
            "collection_name": "container_items",
            "collection_index": 62,
            "size": ["100%", "100%"],
            "bindings": [
              {
                "binding_name": "#hover_text",
                "binding_type": "collection",
                "binding_collection_name": "container_items"
              },
              {
                "binding_type": "view",
                "source_property_name": "(not ((#hover_text - 'L2') = #hover_text))",
                "target_property_name": "#visible"
              }
            ],
            "controls": [

              {"cell_1@backpack.lock_cell": {}},
              {"cell_2@backpack.lock_cell": {}},
              {"cell_3@backpack.lock_cell": {}},
              {"cell_4@backpack.lock_cell": {}},
              {"cell_5@backpack.lock_cell": {}},
              {"cell_6@backpack.lock_cell": {}},
              {"cell_7@backpack.lock_cell": {}},
              {"cell_8@backpack.lock_cell": {}},
              {"cell_9@backpack.lock_cell": {}}
          ]}}
      ]}},

      {"row_3@ng_module.collectionpanel": {
        "collection_name": "container_items",
        "size": ["100%", 21],
        "controls": [

          {"lock": {
            "type": "stack_panel",
            "orientation": "horizontal",
            "collection_name": "container_items",
            "collection_index": 62,
            "size": ["100%", "100%"],
            "bindings": [
              {
                "binding_name": "#hover_text",
                "binding_type": "collection",
                "binding_collection_name": "container_items"
              },
              {
                "binding_type": "view",
                "source_property_name": "(not ((#hover_text - 'L3') = #hover_text))",
                "target_property_name": "#visible"
              }
            ],
            "controls": [

              {"cell_1@backpack.lock_cell": {}},
              {"cell_2@backpack.lock_cell": {}},
              {"cell_3@backpack.lock_cell": {}},
              {"cell_4@backpack.lock_cell": {}},
              {"cell_5@backpack.lock_cell": {}},
              {"cell_6@backpack.lock_cell": {}},
              {"cell_7@backpack.lock_cell": {}},
              {"cell_8@backpack.lock_cell": {}},
              {"cell_9@backpack.lock_cell": {}}
          ]}}
      ]}},

      {"row_4@ng_module.collectionpanel": {
        "collection_name": "container_items",
        "size": ["100%", 21],
        "controls": [

          {"lock": {
            "type": "stack_panel",
            "orientation": "horizontal",
            "collection_name": "container_items",
            "collection_index": 62,
            "size": ["100%", "100%"],
            "bindings": [
              {
                "binding_name": "#hover_text",
                "binding_type": "collection",
                "binding_collection_name": "container_items"
              },
              {
                "binding_type": "view",
                "source_property_name": "(not ((#hover_text - 'L4') = #hover_text))",
                "target_property_name": "#visible"
              }
            ],
            "controls": [

              {"cell_1@backpack.lock_cell": {}},
              {"cell_2@backpack.lock_cell": {}},
              {"cell_3@backpack.lock_cell": {}},
              {"cell_4@backpack.lock_cell": {}},
              {"cell_5@backpack.lock_cell": {}},
              {"cell_6@backpack.lock_cell": {}},
