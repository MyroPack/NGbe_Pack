        "orientation": "horizontal",
        "collection_name": "container_items",
        "size": ["100%", 21],
        "controls": [

          {"slot_27@backpack.backpack_slot": {"$index": 27}},
          {"slot_28@backpack.backpack_slot": {"$index": 28}},
