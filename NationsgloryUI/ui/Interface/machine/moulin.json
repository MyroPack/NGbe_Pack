  // Une case avec, tant qu'elle est vide, l'image de l'objet attendu (ou produit) en transparence : une image fixe du
  // pack ($ghost_texture). Le rendu d'objet lu dans une case cachee ne se voyait pas en jeu (31/10, 16 h 41).
  "slot_with_ghost@ng_module.panel":{
    "size":[21,21],
    "$ghost_texture|default":"",
    "controls":[
      {"cell@ng_module.collectionpanel":{
        "collection_name":"container_items",
        "size":["100%","100%"],
        "controls":[
          {"slot@ng_module.custome_slot":{ "$index":"$slot_index" }},
          {"ghost@moulin.ghost_image":{ "$index":"$slot_index", "layer":10 }}
        ]
      }}
    ]
  },

  // L'image de l'objet attendu, sur la case $index tant qu'elle est vide : texte de survol de la case vide, le test des
  // cartes de la boutique (boutique/inventory.json). Une image ne prend ni clic ni survol : la case dessous les garde.
  "ghost_image@ng_module.panel":{
    "size":["100%","100%"],
    "collection_index":"$index",
    "controls":[
      {"image":{
        "type":"image",
        "texture":"$ghost_texture",
        "size":[16,16],
        "alpha":0.4,
        "bindings":[
          {"binding_name":"#hover_text","binding_type":"collection","binding_collection_name":"container_items"},
          {"binding_type":"view","source_property_name":"(#hover_text = '')","target_property_name":"#visible"}
        ]
      }}
    ]
  },

