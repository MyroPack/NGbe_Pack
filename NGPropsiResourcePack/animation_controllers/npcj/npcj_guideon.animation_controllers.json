            }
          ]
        },
        "forward": {
          "animations": [
            "forward"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "talk": "q.variant == 1"
            },
            {
              "near": "q.variant != 1 && q.ground_speed <= 0.3 && v.npcj_proche"
            },
            {
              "idle": "q.variant != 1 && q.ground_speed <= 0.3 && !v.npcj_proche"
            }
          ]
        },
        "near": {
          "animations": [
            "near"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "talk": "q.variant == 1"
            },
            {
              "forward": "q.variant != 1 && q.ground_speed > 0.3"
            },
            {
              "idle": "q.variant != 1 && q.ground_speed <= 0.3 && !v.npcj_proche"
            }
          ]
        },
        "idle": {
          "animations": [
            "idle"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "talk": "q.variant == 1"
            },
            {
              "forward": "q.variant != 1 && q.ground_speed > 0.3"
            },
            {
              "near": "q.variant != 1 && q.ground_speed <= 0.3 && v.npcj_proche"
            }
          ]
        }
      }
    }
  }
}
