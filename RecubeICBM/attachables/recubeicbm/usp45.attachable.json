{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "ng:usp45",
      "item": {
        "ng:usp45": "query.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/recubeicbm/weapon/usp45",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.recubeicbm.weapon.usp45"
      },
      "animations": {
        "first_person_hold": "animation.recubeicbm.held.usp45.first_person",
        "third_person_hold": "animation.recubeicbm.held.usp45.third_person",
        "no_accessories": "animation.recubeicbm.weapon.no_accessories",
        "idle": "animation.recubeicbm.weapon.usp45.idle",
        "fire": "animation.recubeicbm.weapon.usp45.fire",
        "reload": "animation.recubeicbm.weapon.usp45.reload",
        "weapon": "controller.animation.recubeicbm.weapon"
      },
      "scripts": {
        "animate": [
          {
            "first_person_hold": "c.is_first_person"
          },
          {
            "third_person_hold": "!c.is_first_person"
          },
          "no_accessories",
          "weapon"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
