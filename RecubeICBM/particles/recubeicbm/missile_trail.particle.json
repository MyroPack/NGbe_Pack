{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "recubeicbm:missile_trail",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/campfire_smoke"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.35,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.5, 3.0)"
      },
      "minecraft:particle_initial_speed": "math.random(0.05, 0.25)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.15,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.size = 0.35 + 0.9 * math.pow(variable.particle_age / variable.particle_lifetime, 0.5);"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size",
          "variable.size"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 12,
          "uv": [
            0,
            "math.floor(variable.particle_random_2 * 12)"
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": [
              0.85,
              0.85,
              0.85,
              0.9
            ],
            "0.6": [
              0.6,
              0.6,
              0.6,
              0.6
            ],
            "1.0": [
              0.45,
              0.45,
              0.45,
              0.0
            ]
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
